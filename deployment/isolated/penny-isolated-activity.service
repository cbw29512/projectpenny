[Unit]
Description=Penny isolated activity candidate
# Do not install beside enabled legacy user timers.

[Service]
Type=oneshot
User=penny-project
Group=penny-project
WorkingDirectory=/opt/penny/release
ExecStart=/opt/penny/venv/bin/python -E -s -B -m penny.runtime.activity_publish --config /etc/penny-private/projection/projection.json --mode cycle
TimeoutStartSec=45
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET
InaccessiblePaths=-/etc/penny-private/operator -/etc/penny-private/inference -/etc/penny-private/bridge
InaccessiblePaths=-/run/docker.sock -/run/containerd/containerd.sock -/run/podman/podman.sock -/run/tailscale/tailscaled.sock
SocketBindDeny=any
LimitCORE=0
TasksMax=32
