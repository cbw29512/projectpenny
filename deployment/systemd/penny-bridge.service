[Unit]
Description=Penny restricted outbound mailbox cycle

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/penny/release
ExecStart=%h/.local/share/penny/venv/bin/python -m penny.runtime bridge --config %h/.config/penny/bridge.json
TimeoutStartSec=45
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
